# Backend env — tight, no fallback in production
JWT_SECRET=generate-with-openssl-rand-base64-32-or-secrets-token_urlsafe
FILE_ENC_KEY=separate-key-for-encrypting-phone-bank-32-chars
DATABASE_URL=sqlite:///./techmed.db
ENV=production
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# 43200 = 30 days (persistent until sign out)
