SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=trustmed66@gmail.com
SMTP_PASS=your-16-char-app-password-no-spaces
SMTP_FROM=trustmed66@gmail.com
OTP_EXPIRE_MINUTES=3
OTP_MAX_ATTEMPTS=2
OTP_RESEND_COOLDOWN_SECONDS=60
